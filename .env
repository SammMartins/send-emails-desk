# Configuração para desenvolvimento local com SQLite
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database SQLite para desenvolvimento
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3

# Redis para desenvolvimento (pode usar redis local ou usar banco em memória)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email settings (usar configurações de teste ou reais)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# IMAP settings (usar configurações de teste ou reais)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=True
IMAP_USER=
IMAP_PASSWORD=